DATABASE_URL=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Neon Object Storage (S3-compatible)
S3_BUCKET=your-bucket-name
AWS_ENDPOINT_URL_S3=https://br-xxxx.storage.c-x.eu-central-1.aws.neon.tech
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1

# Microsoft sign in (Auth.js with Entra ID, SITA staff only)
# AUTH_SECRET: generate with  openssl rand -base64 33  (use a different one on Vercel)
AUTH_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Must contain the tenant ID (a GUID), never "common"
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/your-tenant-id/v2.0
# Optional, comma separated. Defaults to squareintheair.com
AUTH_ALLOWED_EMAIL_DOMAINS=squareintheair.com
# Local only: set to true to skip sign in while running next dev. Ignored everywhere else.
AUTH_BYPASS=false
